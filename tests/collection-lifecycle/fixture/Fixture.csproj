<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AbaGame</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LubRoot Condition="'$(LubRoot)' == ''">../../../../lub</LubRoot>
    <DefineConstants>$(DefineConstants);$(FixtureMode)</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(LubRoot)/dotnet/Lub/Lub.csproj" /></ItemGroup>
</Project>
