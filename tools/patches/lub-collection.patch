+static int gamepad_slot(App *app, SDL_JoystickID id) {
+  for (int i = 0; i < LUB_GAMEPAD_SLOTS; ++i)
+    if (app->gamepad_ids[i] == id && app->gamepads[i])
+      return i;
+  return -1;
+}
+
+static void gamepad_add(App *app, SDL_JoystickID id) {
+  if (gamepad_slot(app, id) >= 0)
+    return;
+  for (int i = 0; i < LUB_GAMEPAD_SLOTS; ++i) {
+    if (app->gamepads[i])
+      continue;
+    SDL_Gamepad *pad = SDL_OpenGamepad(id);
+    if (!pad)
+      return;
+    app->gamepads[i] = pad;
+    app->gamepad_ids[i] = id;
+    app->gamepad_down[i] = 0;
+    for (int b = 0; b < SDL_GAMEPAD_BUTTON_COUNT && b < 32; ++b)
+      if (SDL_GetGamepadButton(pad, (SDL_GamepadButton)b))
+        app->gamepad_down[i] |= UINT32_C(1) << b;
+    return;
+  }
+}
+
+void lub_host_gamepads_init(App *app) {
+  if (!SDL_InitSubSystem(SDL_INIT_GAMEPAD)) {
+    SDL_Log("gamepad init failed: %s", SDL_GetError());
+    return;
+  }
+  int count = 0;
+  SDL_JoystickID *ids = SDL_GetGamepads(&count);
+  for (int i = 0; i < count; ++i)
+    gamepad_add(app, ids[i]);
+  SDL_free(ids);
+}
+
+void lub_host_gamepads_shutdown(App *app) {
+  for (int i = 0; i < LUB_GAMEPAD_SLOTS; ++i) {
+    if (app->gamepads[i])
+      SDL_CloseGamepad(app->gamepads[i]);
+    app->gamepads[i] = NULL;
+    app->gamepad_ids[i] = 0;
+  }
+}
