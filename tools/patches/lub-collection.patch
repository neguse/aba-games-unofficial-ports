+}
+
+void app_reset_session(App *app) {
+  // Keep handles and view generations monotonic across game changes.
+  int32_t next_handle = app->res.next_handle;
+  int64_t revision = app->res.revision;
+  int32_t next_phys_handle = app->phys.handles.next_handle;
+  int32_t next_phys3_handle = app->phys3.handles.next_handle;
+  ui_shutdown();
+  app_release_game_resources(app);
+  res_table_init(&app->res);
+  app->res.next_handle = next_handle;
+  app->res.revision = revision;
+  phys2d_state_init(&app->phys);
+  phys3d_state_init(&app->phys3);
+  app->phys.handles.next_handle = next_phys_handle;
+  app->phys3.handles.next_handle = next_phys3_handle;
+  pipeline_cache_init(&app->pip_cache);
+  pass_state_init(&app->pass);
+  pass_state_set_app(&app->pass, app);
+  ++app->frame_index;
+  app->frame_prev_counter = 0;
+  app->frame_dt = 0;
+  app->actual_fps = 0;
+  app->fps_last_ns = 0;
+  app->fps_frame_count = 0;
+  app->resource_sweep_after_frames = 0;
+  app->readback_depth = 8;
+  app->last_error[0] = '\0';
+  app->entry_path[0] = '\0';
+  app->entry_module_name[0] = '\0';
+  app->entry_mtime_cache = 0;
+}
+
+void app_shutdown(App *app) {
+  app_release_game_resources(app);
+  lub_host_gamepads_shutdown(app);
   capture_state_shutdown(&app->capture);
   if (g_backend)
     g_backend->shutdown(app);
   gpu_stats_shutdown(g_backend ? g_backend->name : NULL);
+  g_backend = NULL;
 
   if (app->window)
     SDL_DestroyWindow(app->window);
