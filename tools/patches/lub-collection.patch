diff --git a/dotnet/Lub/LubSession.cs b/dotnet/Lub/LubSession.cs
new file mode 100644
index 0000000..5e5ff28
--- /dev/null
+++ b/dotnet/Lub/LubSession.cs
@@ -0,0 +1,67 @@
+#nullable enable
+using System;
+
+public static unsafe partial class Lub
+{
+    /// <summary>
+    /// Hooks for a .NET host that runs several games in one window or XR session.
+    /// Use these only on the Lub.Run thread. Clear delegates before unloading a
+    /// game assembly, so the shared Lub assembly does not retain that game.
+    /// </summary>
+    public static class Session
+    {
+        /// <summary>Handles game Config calls instead of reconfiguring the host.</summary>
+        public static Action<ConfigOpts>? Configuring { get; set; }
+
+        /// <summary>Handles game Quit calls without ending the host loop.</summary>
+        public static Action? Quitting { get; set; }
+
+        /// <summary>Synchronous game-to-host messages, including final saves.</summary>
+        public static Action<string, string>? HostSending { get; set; }
+
+        /// <summary>Returns one host-to-game message, or a null topic for no message.</summary>
+        public static Func<(string? topic, string? payload)>? HostPolling { get; set; }
+
+        /// <summary>Optional offscreen target returned by Gfx.MainTex.</summary>
+        public static TextureRef? MainTarget { get; set; }
+
+        /// <summary>Optional logical drawable size returned by Gfx.Size.</summary>
+        public static (int width, int height)? MainSize { get; set; }
+
+        /// <summary>Optional game-facing Xr.Active value. Clear it when the host
+        /// draws the offscreen game target in the actual XR session.</summary>
+        public static bool? XrActiveOverride { get; set; }
+
+        /// <summary>Host callback after native frame submission, suitable for
+        /// switching games and Reset. It survives ClearHooks and Reset.</summary>
+        public static Action? AfterFrame { get; set; }
+
+        /// <summary>Remove game-specific delegates and target overrides.</summary>
+        public static void ClearHooks()
+        {
+            Configuring = null;
+            Quitting = null;
+            HostSending = null;
+            HostPolling = null;
+            MainTarget = null;
+            MainSize = null;
+            XrActiveOverride = null;
+        }
+
+        /// <summary>
+        /// Release all game resources, audio, physics and caches, and clear the
+        /// game hooks. Call OnQuit first so saves still reach HostSending. Call
+        /// between frames (for example in AfterFrame); the native API rejects a
+        /// reset inside OnFrame. The host window, GPU, XR session and capture
+        /// schedule survive. Recreate any selector resources afterward.
+        /// </summary>
+        public static void Reset()
+        {
+            if (LubRuntime.Ctx == null)
+                throw new InvalidOperationException("No active Lub.Run host");
+            LubRuntime.Check(LubNative.lub_host_reset_session(LubRuntime.Ctx), "Session.Reset");
+            ++LubRuntime.SessionGeneration;
+            ClearHooks();
+        }
+    }
+}
diff --git a/tests/c/session_gamepad_smoke.c b/tests/c/session_gamepad_smoke.c
new file mode 100644
index 0000000..2698eda
--- /dev/null
+++ b/tests/c/session_gamepad_smoke.c
@@ -0,0 +1,170 @@
+// Headless coverage for session resource cleanup and SDL virtual gamepads.
+#include "api_internal.h"
+#include "backend.h"
+#include "host_api.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int failures, destroyed;
+static void check(bool ok, const char *message) {
+  if (!ok) {
+    fprintf(stderr, "FAIL: %s (%s)\n", message, SDL_GetError());
+    ++failures;
+  }
+}
+static void destroy(uintptr_t handle) {
+  if (handle)
+    ++destroyed;
+}
+static const RenderBackend backend = {.name = "test",
+                                     .destroy_buffer = destroy,
+                                     .destroy_image = destroy,
+                                     .destroy_shader = destroy,
+                                     .destroy_pipeline = destroy};
+
+static SDL_JoystickID attach_pad(const char *name) {
+  SDL_VirtualJoystickDesc desc;
+  SDL_INIT_INTERFACE(&desc);
+  desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+  desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+  desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+  desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+  desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1;
+  desc.name = name;
+  return SDL_AttachVirtualJoystick(&desc);
+}
+
+static void poll(LubContext *ctx) {
+  SDL_UpdateJoysticks();
+  LubEventData event;
+  while (lub_host_poll_event(ctx, &event)) {
+  }
+}
+
+int main(void) {
+  SDL_SetHint(SDL_HINT_VIDEO_DRIVER, "dummy");
+  SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+  if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD))
+    return 1;
+  App *app = calloc(1, sizeof(*app));
+  if (!app)
+    return 1;
+  app->window = SDL_CreateWindow("session smoke", 64, 64, 0);
+  check(app->window != NULL, "dummy window");
+  app->phase = APP_PHASE_POST_BACKEND;
+  pass_state_init(&app->pass);
+  pass_state_set_app(&app->pass, app);
+  phys2d_state_init(&app->phys);
+  phys3d_state_init(&app->phys3);
+  g_backend = &backend;
+  LubContext *ctx = lub_api_ctx(app);
+  lub_host_gamepads_init(app);
+
+  check(!lub_input_gamepad_connected(ctx, -1) &&
+            !lub_input_gamepad_connected(ctx, 4),
+        "out-of-range players are disconnected");
+  check(lub_input_gamepad_axis(ctx, 0, -1) == 0 &&
+            lub_input_gamepad_axis(ctx, 4, 0) == 0 &&
+            !lub_input_gamepad_down(ctx, 0, 32) &&
+            !lub_input_gamepad_pressed(ctx, -1, 0) &&
+            !lub_input_gamepad_released(ctx, 4, 0),
+        "unavailable and invalid input is neutral");
+  SDL_JoystickID first = attach_pad("Lub virtual one");
+  SDL_JoystickID second = attach_pad("Lub virtual two");
+  check(first && second, "attach virtual pads");
+  poll(ctx);
+  check(lub_input_gamepad_connected(ctx, 0) &&
+            lub_input_gamepad_connected(ctx, 1),
+        "hotplug opens stable slots");
+  SDL_Joystick *joy = SDL_OpenJoystick(first);
+  check(joy != NULL, "open virtual joystick");
+  if (joy) {
+    SDL_SetJoystickVirtualAxis(joy, SDL_GAMEPAD_AXIS_LEFTX, -32768);
+    SDL_SetJoystickVirtualAxis(joy, SDL_GAMEPAD_AXIS_RIGHTX, 32767);
+    SDL_SetJoystickVirtualAxis(joy, SDL_GAMEPAD_AXIS_LEFT_TRIGGER, -32768);
+    SDL_SetJoystickVirtualAxis(joy, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 32767);
+    SDL_SetJoystickVirtualButton(joy, SDL_GAMEPAD_BUTTON_SOUTH, true);
+    poll(ctx);
+    check(fabsf(lub_input_gamepad_axis(ctx, 0, 0) + 1.0f) < .0001f,
+          "negative axis endpoint");
+    check(fabsf(lub_input_gamepad_axis(ctx, 0, 2) - 1.0f) < .0001f,
+          "positive axis endpoint");
+    check(lub_input_gamepad_axis(ctx, 0, 4) == 0 &&
+              fabsf(lub_input_gamepad_axis(ctx, 0, 5) - 1.0f) < .0001f,
+          "trigger endpoints normalized to zero and one");
+    check(lub_input_gamepad_down(ctx, 0, 0) &&
+              lub_input_gamepad_pressed(ctx, 0, 0),
+          "button state and press latch");
+    SDL_SetJoystickVirtualButton(joy, SDL_GAMEPAD_BUTTON_SOUTH, false);
+    poll(ctx);
+    check(!lub_input_gamepad_down(ctx, 0, 0) &&
+              lub_input_gamepad_pressed(ctx, 0, 0) &&
+              lub_input_gamepad_released(ctx, 0, 0),
+          "same-frame press/release preserves both edges");
+    SDL_SetJoystickVirtualButton(joy, SDL_GAMEPAD_BUTTON_EAST, true);
+    poll(ctx);
+  }
+  check(SDL_DetachVirtualJoystick(first), "detach first pad");
+  poll(ctx);
+  check(!lub_input_gamepad_connected(ctx, 0) &&
+            lub_input_gamepad_connected(ctx, 1),
+        "disconnect does not renumber another pad");
+  check(lub_input_gamepad_released(ctx, 0, 1),
+        "disconnect releases held buttons");
+  if (joy)
+    SDL_CloseJoystick(joy);
+  SDL_JoystickID replacement = attach_pad("Lub virtual replacement");
+  poll(ctx);
+  check(app->gamepad_ids[0] == replacement && app->gamepad_ids[1] == second,
+        "new pad fills the vacated slot");
+
+  ResEntry *entry = res_table_get_or_create(&app->res, "same-key", RES_TEXTURE);
+  check(entry != NULL, "resource allocated");
+  int old_handle = entry ? entry->handle : 0;
+  if (entry)
+    entry->u.tex.h = 123;
+  int old_body = 0;
+  for (int i = 0; i < 300; ++i)
+    old_body = phys_handle_alloc(&app->phys.handles, app, PHYS_HANDLE_BODY);
+  app->host_poll_buf = malloc(8);
+  app->frame_prev_counter = 999;
+  app->key_pressed[SDL_SCANCODE_SPACE] = true;
+  app->frame_active = true;
+  check(lub_host_reset_session(ctx) == LUB_ERROR && destroyed == 0,
+        "in-frame reset rejects without freeing resources");
+  app->frame_active = false;
+  SDL_Window *window = app->window;
+  check(lub_host_reset_session(ctx) == LUB_OK, "between-frame reset");
+  check(destroyed == 1 && app->window == window && g_backend == &backend &&
+            app->phase == APP_PHASE_POST_BACKEND,
+        "resources released while window and backend survive");
+  check(!app->host_poll_buf && app->frame_prev_counter == 0 &&
+            !app->key_pressed[SDL_SCANCODE_SPACE] &&
+            !lub_input_gamepad_pressed(ctx, 0, 0),
+        "host buffer, clock and input edges reset");
+  entry = res_table_get_or_create(&app->res, "same-key", RES_TEXTURE);
+  check(entry && entry->handle > old_handle &&
+            !res_table_get_by_handle(&app->res, old_handle),
+        "old resource handle cannot alias next game's same key");
+  int new_body = phys_handle_alloc(&app->phys.handles, app, PHYS_HANDLE_BODY);
+  check(new_body > old_body && app->phys.handles.slots[old_body].ptr == NULL,
+        "physics handles remain stale across reset and table growth");
+  app->quit_requested = true;
+  check(lub_host_reset_session(ctx) == LUB_OK && lub_host_quit_requested(ctx),
+        "physical host quit survives reset");
+  check(lub_input_gamepad_connected(ctx, 0) &&
+            lub_input_gamepad_connected(ctx, 1),
+        "open gamepads survive repeated resets");
+  lub_host_gamepads_shutdown(app);
+  SDL_DetachVirtualJoystick(second);
+  SDL_DetachVirtualJoystick(replacement);
+  SDL_DestroyWindow(window);
+  free(app);
+  g_backend = NULL;
+  SDL_Quit();
+  if (!failures)
+    puts("session/gamepad smoke: PASS");
+  return failures ? 1 : 0;
+}
diff --git a/tests/c/session_test_host.c b/tests/c/session_test_host.c
new file mode 100644
index 0000000..88563ba
--- /dev/null
+++ b/tests/c/session_test_host.c
@@ -0,0 +1,191 @@
+// Test-only shared library for managed game lifecycle tests. This deliberately
+// does not render pixels. It exercises the normal C APIs with SDL dummy video,
+// real shader compilation, resource bookkeeping, audio, file IO and physics.
+#include "api_internal.h"
+#include "backend.h"
+#include "host_api.h"
+#include <stdlib.h>
+#include <string.h>
+
+static int live_resources;
+static uint64_t draw_calls;
+static uintptr_t allocate_resource(void) {
+  void *p = calloc(1, 1);
+  if (p)
+    ++live_resources;
+  return (uintptr_t)p;
+}
+
+LUB_API int lub_test_live_resources(void) { return live_resources; }
+LUB_API uint64_t lub_test_draw_calls(void) { return draw_calls; }
+LUB_API int lub_test_session_allocations(LubContext *ctx) {
+  App *app = lub_api_app(ctx);
+  return (app->audio != NULL) + (app->audio_snds != NULL) +
+         (app->readbacks != NULL) + (app->io_cache != NULL) +
+         (app->font_scratch != NULL) + (app->mesh_scratch != NULL) +
+         (app->host_poll_buf != NULL) + (app->frame_garbage_count != 0) +
+         (app->res.by_handle != NULL) + (app->phys.handles.slots != NULL) +
+         (app->phys3.handles.slots != NULL);
+}
+
+static void noop_shutdown(App *app) { (void)app; }
+static void noop_begin_frame(App *app, int *w, int *h) {
+  SDL_GetWindowSizeInPixels(app->window, w, h);
+}
+static void noop_end_frame(App *app) { (void)app; }
+static BackendBuffer noop_buffer(SglBufferType type, const void *data,
+                                 size_t bytes) {
+  (void)type;
+  (void)data;
+  (void)bytes;
+  return allocate_resource();
+}
+static BackendImage noop_image(const ImageDesc *desc) {
+  (void)desc;
+  return allocate_resource();
+}
+static BackendShader noop_shader(const ShaderDesc *desc) {
+  (void)desc;
+  return allocate_resource();
+}
+static BackendPipeline noop_pipeline(const PipelineDesc *desc) {
+  (void)desc;
+  return allocate_resource();
+}
+static void noop_destroy(uintptr_t handle) {
+  if (handle) {
+    --live_resources;
+    free((void *)handle);
+  }
+}
+static void noop_update(uintptr_t handle, const void *data, size_t bytes) {
+  (void)handle;
+  (void)data;
+  (void)bytes;
+}
+static void noop_begin_pass(App *app, const PassBeginDesc *desc) {
+  (void)app;
+  (void)desc;
+}
+static void noop_apply_pipeline(BackendPipeline pipeline) { (void)pipeline; }
+static void noop_bindings(const BindingsDesc *desc) { (void)desc; }
+static void noop_uniforms(SglShaderStage stage, int slot, const void *data,
+                           size_t bytes) {
+  (void)stage;
+  (void)slot;
+  (void)data;
+  (void)bytes;
+}
+static void noop_draw(int base, int count, int instances) {
+  (void)base;
+  (void)count;
+  (void)instances;
+  ++draw_calls;
+}
+static void noop_scissor(int x, int y, int w, int h) {
+  (void)x;
+  (void)y;
+  (void)w;
+  (void)h;
+}
+static void noop_dispatch(App *app, const ComputeDispatchDesc *desc) {
+  (void)app;
+  (void)desc;
+  ++draw_calls;
+}
+static bool noop_readback(App *app, BackendImage image, int w, int h,
+                           SglPixelFormat fmt, BackendReadback *out) {
+  (void)app;
+  (void)image;
+  (void)w;
+  (void)h;
+  (void)fmt;
+  *out = 0;
+  return false;
+}
+static ReadbackPollStatus noop_poll(BackendReadback request,
+                                     ReadbackResult *out) {
+  (void)request;
+  memset(out, 0, sizeof(*out));
+  return READBACK_POLL_ERROR;
+}
+static bool noop_capture(App *app, const char *path) {
+  (void)app;
+  (void)path;
+  return false;
+}
+static SglPixelFormat noop_format(App *app) {
+  (void)app;
+  return SGL_PF_RGBA8;
+}
+
+static const RenderBackend test_backend = {
+    .name = "session-test-no-render",
+    .shutdown = noop_shutdown,
+    .begin_frame = noop_begin_frame,
+    .end_frame = noop_end_frame,
+    .make_buffer = noop_buffer,
+    .make_image = noop_image,
+    .make_shader = noop_shader,
+    .make_pipeline = noop_pipeline,
+    .destroy_buffer = noop_destroy,
+    .destroy_image = noop_destroy,
+    .destroy_shader = noop_destroy,
+    .destroy_pipeline = noop_destroy,
+    .update_buffer = noop_update,
+    .update_image = noop_update,
+    .begin_pass = noop_begin_pass,
+    .end_pass = noop_end_frame,
+    .apply_pipeline = noop_apply_pipeline,
+    .apply_bindings = noop_bindings,
+    .apply_uniforms = noop_uniforms,
+    .draw = noop_draw,
+    .set_scissor = noop_scissor,
+    .dispatch = noop_dispatch,
+    .request_readback_image = noop_readback,
+    .poll_readback = noop_poll,
+    .destroy_readback = noop_destroy,
+    .capture = noop_capture,
+    .swapchain_color_format = noop_format,
+};
+
+// Set LUB_NATIVE_LIB to this test library before the first managed API call.
+// Assign the returned context to LubRuntime.Ctx in the test harness, then use
+// lub_host_poll_event/frame_begin/frame_end/reset_session/destroy normally.
+// Do not call lub_host_start: the test backend is already installed.
+LUB_API LubContext *lub_test_host_create(void) {
+  if (g_backend)
+    return NULL;
+  live_resources = 0;
+  draw_calls = 0;
+  SDL_SetHint(SDL_HINT_VIDEO_DRIVER, "dummy");
+  SDL_SetHint(SDL_HINT_ASSERT, "abort");
+  if (!SDL_Init(SDL_INIT_VIDEO))
+    return NULL;
+  App *app = calloc(1, sizeof(*app));
+  if (!app) {
+    SDL_Quit();
+    return NULL;
+  }
+  app->window = SDL_CreateWindow("Lub lifecycle test (no rendering)", 1280, 960, 0);
+  if (!app->window) {
+    free(app);
+    SDL_Quit();
+    return NULL;
+  }
+  pass_state_init(&app->pass);
+  pass_state_set_app(&app->pass, app);
+  profile_state_init(&app->profile);
+  res_table_init(&app->res);
+  pipeline_cache_init(&app->pip_cache);
+  phys2d_state_init(&app->phys);
+  phys3d_state_init(&app->phys3);
+  capture_state_init(&app->capture);
+  app->phase = APP_PHASE_POST_BACKEND;
+  app->readback_depth = 8;
+  app->fixed_frame_dt = 1.0 / 60.0;
+  strcpy(app->backend_name, "test");
+  g_backend = &test_backend;
+  lub_host_gamepads_init(app);
+  return lub_api_ctx(app);
+}
