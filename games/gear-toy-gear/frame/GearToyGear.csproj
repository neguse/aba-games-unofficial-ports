<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LubRoot Condition="'$(LubRoot)' == ''">../../../.cache/lub</LubRoot>
    <BaseOutputPath>../../../build/frame/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LubRoot)/dotnet/Lub/Lub.csproj" />
    <Compile Include="../*.cs" Exclude="../Render.cs;../Pad.cs" />
    <Compile Include="../../../game/PatternNumber.cs;../../../build/gear-toy-gear/Data.cs" />
    <Content Include="game.vs.slang;../game.fs.slang" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="LICENSE.txt" />
    <Content Include="run.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
