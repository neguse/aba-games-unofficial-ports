<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LubRoot Condition="'$(LubRoot)' == ''">../../../.cache/lub</LubRoot>
    <BaseOutputPath>../../../build/mm-frame/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LubRoot)/dotnet/Lub/Lub.csproj" />
    <ProjectReference Include="$(LubRoot)/third_party/tcs/TinySystem/TinySystem.csproj" />
    <Compile Include="../*.cs" />
    <Compile Include="$(LubRoot)/cs-lib/lubx/XrAnchor.cs" Link="lubx/XrAnchor.cs" />
    <Compile Include="../../../game/SimulationTime.cs" />
    <Compile Include="../../../game/PatternNumber.cs;../../../build/mazer-mayhem/Data.cs" />
    <Content Include="../game.vs.slang;../game.fs.slang" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../frame/scene.output.slang" CopyToOutputDirectory="PreserveNewest" Link="scene.output.slang" />
    <Content Include="../LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="LICENSE.txt" />
    <Content Include="run.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
