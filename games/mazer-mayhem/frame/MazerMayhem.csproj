<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LubRoot Condition="'$(LubRoot)' == ''">../../../.cache/lub</LubRoot>
    <BaseOutputPath>../../../build/mm-frame/bin/</BaseOutputPath>
    <!-- The Frame build names the runtime here, not with -r, so that it stays out of lub's projects (their lock files have none) -->
    <RuntimeIdentifier>$(FrameRuntime)</RuntimeIdentifier>
    <SelfContained Condition="'$(FrameRuntime)' != ''">true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LubRoot)/dotnet/Lub/Lub.csproj" />
    <ProjectReference Include="$(LubRoot)/src/tcs-system/tcs-system.csproj" />
    <Compile Include="../*.cs" />
    <Compile Include="$(LubRoot)/cs-lib/lubx/XrAnchor.cs" Link="lubx/XrAnchor.cs" />
    <Compile Include="$(LubRoot)/cs-lib/lub/*.cs" Link="lub/%(Filename)%(Extension)" />
    <Compile Include="../../../game/SimulationTime.cs" />
    <Compile Include="../../../game/Scene.cs;../../../game/Standalone.cs;../../../game/AsciiText.cs" />
    <Compile Include="../../../game/PatternNumber.cs;../../../build/mazer-mayhem/Data.cs" />
    <Content Include="../game.vs.slang;../game.fs.slang" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../frame/scene.output.slang" CopyToOutputDirectory="PreserveNewest" Link="scene.output.slang" />
    <Content Include="../LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="LICENSE.txt" />
    <Content Include="run.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Math / MathF を TinySystem.Math にし、.NET 実行の Math の超越関数を
       web (tcs2c) と bit 単位で同じ結果にする -->
  <Import Project="$(LubRoot)/src/tcs-system/tcs-system.props" />
</Project>
